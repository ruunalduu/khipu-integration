# Credenciales de Khipu (API v3)
# API Key: Portal Khipu → Opciones de cuenta → Para integrar Khipu → API Keys → Nueva API Key
KHIPU_API_KEY=tu_api_key_aqui
# Receiver ID: útil para soporte (lo encuentras en Opciones de cuenta → Id de cobrador)
KHIPU_RECEIVER_ID=tu_receiver_id_aqui

# URL base de tu app (para los callbacks de Khipu)
# En desarrollo local usar ngrok o similar
APP_BASE_URL=http://localhost:5000

# Flask
FLASK_SECRET_KEY=cambia_esto_por_una_clave_aleatoria_segura
FLASK_DEBUG=true
